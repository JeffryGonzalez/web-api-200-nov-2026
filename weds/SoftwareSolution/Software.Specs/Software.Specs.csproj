<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <OutputType>Exe</OutputType>
    <RootNamespace>Software.Specs</RootNamespace>
    <TargetFramework>net10.0</TargetFramework>
	  <IsTestProject>true</IsTestProject>
	  <UseMicrosoftTestingPlatformRunner>true</UseMicrosoftTestingPlatformRunner>
	  <TestingPlatformDotnetTestSupport>true</TestingPlatformDotnetTestSupport>

	  <!-- the same version for all three Bobcat packages -->
	  <BobcatVersion>1.0.0</BobcatVersion>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
	  <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.11.0" />
	  <PackageReference Include="Alba" Version="9.0.0-rc.3" />
	  <PackageReference Include="Testcontainers.PostgreSql" Version="4.16.0" />
	  <PackageReference Include="NSubstitute" Version="6.2.0" />
	  <PackageReference Include="xunit.v3" Version="4.0.2" />
	  <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
	  <PackageReference Include="xunit.runner.visualstudio" Version="4.0.1" PrivateAssets="all" />

	  <PackageReference Include="Bobcat" Version="$(BobcatVersion)" />
	  <PackageReference Include="Bobcat.Generators" Version="$(BobcatVersion)" PrivateAssets="all" />
	  <PackageReference Include="Bobcat.Xunit" Version="$(BobcatVersion)" />

  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Software.Api\Software.Api.csproj" />
  </ItemGroup>

</Project>
