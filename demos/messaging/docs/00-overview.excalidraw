    {
      "id": "7v-LV1jAIw605ykRI5eJV",
      "type": "text",
      "x": 194.5,
      "y": 907,
      "width": 759,
      "height": 275,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aF",
      "roundness": null,
      "seed": 2076779841,
      "version": 471,
      "versionNonce": 922264623,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1793797861845,
      "link": null,
      "locked": false,
      "text": "Some Scenarios\n- Changing a Point of Contact\n    - Memories of a vendor with a specific point of contact\n    - Guess, based on that, I can change the point of contact\n    - Apology - Conflict with e-tag\n- Adding a License\n    - Probably safe, right?\n    - What *should* happen?\n    - Request is written to a local database, sent to the license api\n        - if the license API fails, do we have a license?\n        - What have we already told them?",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Some Scenarios\n- Changing a Point of Contact\n    - Memories of a vendor with a specific point of contact\n    - Guess, based on that, I can change the point of contact\n    - Apology - Conflict with e-tag\n- Adding a License\n    - Probably safe, right?\n    - What *should* happen?\n    - Request is written to a local database, sent to the license api\n        - if the license API fails, do we have a license?\n        - What have we already told them?",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "KC8iK7b7GJu5CTB6wrBvc",
      "type": "text",
      "x": 970,
      "y": 906,
      "width": 638,
      "height": 100,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aG",
      "roundness": null,
      "seed": 868965889,
      "version": 120,
      "versionNonce": 147694575,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1793797938221,
      "link": null,
      "locked": false,
      "text": "If your \"inside\" is relying on guesses from other systems,\nyou can only create new guesses.\n\n",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "If your \"inside\" is relying on guesses from other systems,\nyou can only create new guesses.\n\n",
      "autoResize": true,
      "lineHeight": 1.25
    }
