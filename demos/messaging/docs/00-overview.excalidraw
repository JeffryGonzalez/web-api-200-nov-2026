      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aH",
      "roundness": null,
      "seed": 1569479772,
      "version": 165,
      "versionNonce": 299793508,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1793812426390,
      "link": null,
      "locked": false,
      "text": "1. - Do we really have to do that pricing thing inline with the POST to license (background work)\n2. - Messaging (async, etc.)",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "1. - Do we really have to do that pricing thing inline with the POST to license (background work)\n2. - Messaging (async, etc.)",
