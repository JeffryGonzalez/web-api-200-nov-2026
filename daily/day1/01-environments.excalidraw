    {
      "id": "ZaMHKpcEhGslVsQ5AuGrX",
      "type": "text",
      "x": 394,
      "y": 1360,
      "width": 706.9996337890625,
      "height": 175,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aO",
      "roundness": null,
      "seed": 1563362688,
      "version": 416,
      "versionNonce": 1539552640,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1793638185557,
      "link": null,
      "locked": false,
      "text": "Most apis run in containers. Containers *should* specify limits\nfor memory and processor.\nWe scale \"out\" using the process model (this is a 12 factor app thing)\n    - requests - how much you need to get started\n    - limits - don't let me use more than this\n    - if the limit is reached, you allocate more instances of the container\n        - \"that's the scale out using the process model\" ",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Most apis run in containers. Containers *should* specify limits\nfor memory and processor.\nWe scale \"out\" using the process model (this is a 12 factor app thing)\n    - requests - how much you need to get started\n    - limits - don't let me use more than this\n    - if the limit is reached, you allocate more instances of the container\n        - \"that's the scale out using the process model\" ",
      "autoResize": true,
      "lineHeight": 1.25
    },
