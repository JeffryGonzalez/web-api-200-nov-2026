      "boundElements": null,
      "updated": 1793806010584,
      "link": null,
      "locked": false,
      "text": "this is not supposed to talk to any other origins\nthan the \"mother ship\" - same origin\n\nThis allows you to make this about as secure as the web\ncan be - \n    - Same-site strict cookies\n    - (other browser based app things...)",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "this is not supposed to talk to any other origins\nthan the \"mother ship\" - same origin\n\nThis allows you to make this about as secure as the web\ncan be - \n    - Same-site strict cookies\n    - (other browser based app things...)",
      "autoResize": true,
      "lineHeight": 1.25
    },
