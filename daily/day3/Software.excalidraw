      "boundElements": [],
      "updated": 1793819266376,
      "link": null,
      "locked": false,
      "text": "POST is not idempotent\nPUT/DELETE are* idempotent\n    - but you can break that! Dont.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "POST is not idempotent\nPUT/DELETE are* idempotent\n    - but you can break that! Dont.",
      "autoResize": true,
      "lineHeight": 1.25
    },
