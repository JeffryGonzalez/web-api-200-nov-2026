      "boundElements": [],
      "updated": 1793818834982,
      "link": null,
      "locked": false,
      "text": "\nThe only failure that can be handled is the client not knowing if you got the request.\n Send the first one with an Idempotency-Key - store it. Check it when the post comes in again.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "\nThe only failure that can be handled is the client not knowing if you got the request.\n Send the first one with an Idempotency-Key - store it. Check it when the post comes in again.",
      "autoResize": true,
      "lineHeight": 1.25
    },
