      "text": "handing it off for something else to handle it.\n- ",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "handing it off for something else to handle it.\n- ",
      "autoResize": true,
      "lineHeight": 1.25
